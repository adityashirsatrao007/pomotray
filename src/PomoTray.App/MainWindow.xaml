<Window x:Class="PomoTray.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PomoTray settings"
        Height="360" Width="440"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="18">
        <TextBlock Text="Focus sessions" FontSize="18" FontWeight="SemiBold" />

        <TextBlock Margin="0,4,0,18"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Text="The timer keeps running when this window is hidden — it lives in the system tray. Ctrl+Alt+P starts or pauses it from anywhere." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Work minutes" VerticalAlignment="Center" Margin="0,0,0,10" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="WorkMinutesBox" Padding="6,4" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Break minutes" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BreakMinutesBox" Padding="6,4" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="Save" Click="OnSave" Padding="18,6" IsDefault="True" />
            <Button Content="Hide to tray" Click="OnHide" Padding="14,6" Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#B00020" />

        <TextBlock x:Name="StatusText" Margin="0,16,0,0" Opacity="0.6" TextWrapping="Wrap" />
    </StackPanel>
</Window>
